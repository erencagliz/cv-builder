{
  "name": "cv-builder",
  "private": true,
  "version": "1.0.0",
  "description": "A free, private, ATS-friendly CV builder that runs entirely in the browser.",
  "license": "MIT",
  "author": "Eren Çağlı",
  "homepage": "https://cv-builder-eight-snowy.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erencagliz/cv-builder.git"
  },
  "bugs": {
    "url": "https://github.com/erencagliz/cv-builder/issues"
  },
  "keywords": [
    "cv",
    "resume",
    "ats",
    "typst",
    "pdf",
    "react",
    "pwa",
    "local-first"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "fonts": "python3 scripts/build-fonts.py",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "dexie": "^4.4.7",
    "docx": "^9.15.3",
    "immer": "^11.2.10",
    "jszip": "^3.10.2",
    "nanoid": "^6.0.2",
    "pdfjs-dist": "^6.5.438",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
